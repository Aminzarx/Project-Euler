# ---------------------------------------------------------------------------
# SMS provider selection — the RSVP backend is provider-agnostic.
# Set SMS_PROVIDER to one of: kavenegar | melipayamak | farazsms | none
# "none" logs the message instead of sending (safe default for local dev).
# ---------------------------------------------------------------------------
SMS_PROVIDER=none

# Recipient numbers the backend routes SMS to based on RSVP "side"
SMS_RECIPIENT_BRIDE=09152034261
SMS_RECIPIENT_GROOM=09159205387

# --- Kavenegar ---
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# --- Melipayamak ---
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_SENDER=

# --- FarazSMS (ippanel) ---
FARAZSMS_API_KEY=
FARAZSMS_SENDER=

# Public site URL, used for absolute metadata/OG tags
NEXT_PUBLIC_SITE_URL=https://zarandix.ir/Wedding
