# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://referral:referral@localhost:5432/referral_economy?schema=public"

# Port the HTTP API listens on.
PORT=4000

# Shared-secret header required on every /api/admin/* request (see src/middleware/adminAuth.ts).
# Generate a long random value for real deployments — this is not a user password, it's a
# service credential for whatever internal admin tool calls these endpoints.
ADMIN_API_KEY="change-me"
